{
  "name": "next-stop-classroom-local",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client"
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 3000,
    "local_protocol": "http"
  },
  "send_metrics": false,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "find_additional_modules": true,
  "base_dir": "dist/server"
}
